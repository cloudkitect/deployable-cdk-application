           CURRENT_TAG=$(git describe --tags $(git rev-list --tags --max-count=1)) 
           echo "CURRENT_TAG=$CURRENT_TAG" >> $GITHUB_ENV 
          else 
           echo "CURRENT_TAG=\${{ github.event.inputs.tag }}" >> $GITHUB_ENV 
          fi
      - name: Checkout
        id: checkout_2
        uses: actions/checkout@v7
        with:
          fetch-depth: 0
          ref: \${{ env.CURRENT_TAG }}
      - name: Setup pnpm
        id: setup_pnpm
        uses: pnpm/action-setup@v6
        with:
          version: "9"
      - name: Setup Node.js
