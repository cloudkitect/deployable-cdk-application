          path: dist
      - name: Restore build artifact permissions
        id: restore_build_artifact_permissions
        run: cd dist && setfacl --restore=permissions-backup.acl
        continue-on-error: true
      - name: Release
        id: release
        if: \${{ !inputs.dry_run }}
        env:
          RELEASE_TAG_FILE: dist/releasetag.txt
          CHANGELOG_FILE: dist/changelog.md
          GITHUB_TOKEN: \${{ secrets.GITHUB_TOKEN }}
        run: |-
          errout=$(mktemp)
          tag=$(cat "$RELEASE_TAG_FILE")
          gh release create "$tag" -R "$GITHUB_REPOSITORY" -F "$CHANGELOG_FILE" -t "$tag" --target "$GITHUB_SHA" \${PRERELEASE:+-p} 2> "$errout" && true
          exitcode=$?
          if [ $exitcode -ne 0 ] && ! grep -q "Release.tag_name already exists" "$errout"; then
            cat "$errout"
            exit $exitcode
          fi
  Deploy_Dev_Api:
    needs: release_github
    runs-on: ubuntu-24.04-arm
    permissions:
      contents: write
      deployments: read
      id-token: write
      issues: write
    steps:
      - name: Checkout
        id: checkout
        uses: actions/checkout@v7
        with:
          fetch-depth: 0
          ref: main
      - name: Get tag
        id: get_tag
        run: |-
          if [ -z "\${{ github.event.inputs.tag }}" ]; then 
           CURRENT_TAG=$(git describe --tags $(git rev-list --tags --max-count=1)) 
           echo "CURRENT_TAG=$CURRENT_TAG" >> $GITHUB_ENV 
          else 
           echo "CURRENT_TAG=\${{ github.event.inputs.tag }}" >> $GITHUB_ENV 
          fi
      - name: Checkout
        id: checkout_2
        uses: actions/checkout@v7
        with:
          fetch-depth: 0
          ref: \${{ env.CURRENT_TAG }}
      - name: Setup pnpm
        id: setup_pnpm
        uses: pnpm/action-setup@v6
        with:
          version: "9"
      - name: Setup Node.js
        id: setup_node_js
        uses: actions/setup-node@v7
        with:
          node-version: 14.18.1
          package-manager-cache: false
      - name: Install dependencies
        id: install_dependencies
        run: pnpm i --frozen-lockfile
      - name: Assume AWS Role in Dev_Api
        id: assume_aws_role_in_dev_api
        uses: aws-actions/configure-aws-credentials@v6
        with:
          role-to-assume: devRoleApi
          aws-region: us-east-1
          role-session-name: Session_Dev_Api
      - name: Deployment to Dev_Api
        id: deployment_to_dev_api
        run: pnpm Deploy_Dev_Api
  Deploy_Dev_Web:
    needs: release_github
    runs-on: ubuntu-24.04-arm
    permissions:
      contents: write
      deployments: read
      id-token: write
      issues: write
    steps:
      - name: Checkout
        id: checkout
        uses: actions/checkout@v7
        with:
          fetch-depth: 0
          ref: main
      - name: Get tag
        id: get_tag
        run: |-
          if [ -z "\${{ github.event.inputs.tag }}" ]; then 
           CURRENT_TAG=$(git describe --tags $(git rev-list --tags --max-count=1)) 
           echo "CURRENT_TAG=$CURRENT_TAG" >> $GITHUB_ENV 
          else 
           echo "CURRENT_TAG=\${{ github.event.inputs.tag }}" >> $GITHUB_ENV 
          fi
      - name: Checkout
        id: checkout_2
        uses: actions/checkout@v7
        with:
          fetch-depth: 0
          ref: \${{ env.CURRENT_TAG }}
      - name: Setup pnpm
        id: setup_pnpm
        uses: pnpm/action-setup@v6
        with:
          version: "9"
      - name: Setup Node.js
        id: setup_node_js
        uses: actions/setup-node@v7
        with:
          node-version: 14.18.1
          package-manager-cache: false
      - name: Install dependencies
        id: install_dependencies
        run: pnpm i --frozen-lockfile
      - name: Assume AWS Role in Dev_Web
        id: assume_aws_role_in_dev_web
        uses: aws-actions/configure-aws-credentials@v6
        with:
          role-to-assume: devRoleWeb
          aws-region: us-east-1
          role-session-name: Session_Dev_Web
      - name: Deployment to Dev_Web
        id: deployment_to_dev_web
        run: pnpm Deploy_Dev_Web
  Deploy_Prod_Api:
    needs:
      - release_github
      - Deploy_Dev_Api
      - Deploy_Dev_Web
    runs-on: ubuntu-24.04-arm
    permissions:
      contents: write
      deployments: read
      id-token: write
      issues: write
    steps:
      - name: Checkout
        id: checkout
        uses: actions/checkout@v7
        with:
          fetch-depth: 0
          ref: main
      - name: Get tag
        id: get_tag
        run: |-
          if [ -z "\${{ github.event.inputs.tag }}" ]; then 
           CURRENT_TAG=$(git describe --tags $(git rev-list --tags --max-count=1)) 
           echo "CURRENT_TAG=$CURRENT_TAG" >> $GITHUB_ENV 
          else 
           echo "CURRENT_TAG=\${{ github.event.inputs.tag }}" >> $GITHUB_ENV 
          fi
      - name: Checkout
        id: checkout_2
        uses: actions/checkout@v7
        with:
          fetch-depth: 0
          ref: \${{ env.CURRENT_TAG }}
      - name: Setup pnpm
        id: setup_pnpm
        uses: pnpm/action-setup@v6
        with:
          version: "9"
      - name: Setup Node.js
        id: setup_node_js
        uses: actions/setup-node@v7
        with:
          node-version: 14.18.1
          package-manager-cache: false
      - name: Install dependencies
        id: install_dependencies
        run: pnpm i --frozen-lockfile
      - name: Assume AWS Role in Prod_Api
        id: assume_aws_role_in_prod_api
        uses: aws-actions/configure-aws-credentials@v6
        with:
          role-to-assume: prodRoleApi
          aws-region: us-east-1
          role-session-name: Session_Prod_Api
      - name: Deployment to Prod_Api
        id: deployment_to_prod_api
        run: pnpm Deploy_Prod_Api
  Deploy_Prod_Web:
    needs: Deploy_Prod_Api
    runs-on: ubuntu-24.04-arm
    permissions:
      contents: write
