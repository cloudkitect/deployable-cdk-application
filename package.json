  "dependencies": {
    "projen": "^0.103.1"
  },
  "pnpm": {},
  "keywords": [
    "AI architect as a service",
    "AWS CDK",
    "CDK pipeline",
    "Cloud architect as a service",
    "CloudKitect",
    "CloudKitect Inc",
    "Deployment",
    "Generative AI",
    "Release CDK App",
    "Typescript",
    "projen"
  ],
  "engines": {
    "node": ">= 20.16.0"
  },
  "devEngines": {
    "packageManager": {
      "name": "pnpm",
      "version": "10.34.5",
      "onFail": "ignore"
    }
  },
  "main": "lib/index.js",
  "license": "MIT",
  "stability": "stable",
  "publishConfig": {
    "access": "public"
  },
  "version": "0.0.0",
  "packageManager": "pnpm@10.34.5",
  "jest": {
    "coverageProvider": "v8",
    "testMatch": [
      "<rootDir>/@(src|test)/**/*(*.)@(spec|test).ts?(x)",
      "<rootDir>/@(src|test)/**/__tests__/**/*.ts?(x)",
      "<rootDir>/@(projenrc)/**/*(*.)@(spec|test).ts?(x)",
      "<rootDir>/@(projenrc)/**/__tests__/**/*.ts?(x)"
    ],
    "clearMocks": true,
    "collectCoverage": true,
    "coverageReporters": [
      "json",
      "lcov",
      "clover",
      "cobertura",
      "text"
    ],
    "coverageDirectory": "coverage",
    "coveragePathIgnorePatterns": [
      "/node_modules/"
    ],
    "testPathIgnorePatterns": [
      "/node_modules/"
    ],
    "watchPathIgnorePatterns": [
      "/node_modules/"
    ],
    "reporters": [
      "default",
      [
        "jest-junit",
        {
          "outputDirectory": "test-reports"
        }
      ]
    ],
    "transform": {
      "^.+\\.[t]sx?$": [
        "ts-jest",
        {
          "tsconfig": "test/tsconfig.json"
        }
      ]
    }
  },
  "types": "lib/index.d.ts",
  "jsii": {
    "outdir": "dist",
    "targets": {},
    "tsconfig": "tsconfig.json",
    "validateTsconfig": "strict"
  },
  "//": "~~ Generated by projen. To modify, edit .projenrc.ts and run \"pnpm exec projen\"."
}
